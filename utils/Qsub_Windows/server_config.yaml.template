# PBS PRO Job Monitor Configuration
# ================================

# PBS Pro command paths on Linux servers
pbs:
  qdel_path: "/opt/pbs/bin/qdel"
  qsub_path: "/opt/pbs/bin/qsub"

# Linux filesystem configuration
paths:
  # Base path for user directories (username will be appended)
  # Final path: {linux_base_path}/{username}
  linux_base_path: "/mnt/fhgfs"

  # Name of the job monitoring script on remote servers
  remote_script_name: "que.py"

# Drive letter to server IP/hostname mapping
# Used to determine which server handles which Windows drive
drive_mapping:
  V: "10.x.x.x"
  X: "10.x.x.x"
  Y: "10.x.x.x"
  Z: "10.x.x.x"

# Server configurations
# Note: 'username' and 'key_file' will be auto-populated at runtime
# based on the current Windows user
servers:
  - hostname: "10.x.x.x"
    name: "server-1"

  - hostname: "10.x.x.x"
    name: "server-2"

# Python interpreter path (used when the agent invokes this script)
# Leave empty to auto-detect: "python" on Windows, "python3" on macOS/Linux
python_path: ""

# SSH Configuration (optional overrides)
ssh:
  connection_timeout: 10  # seconds
  # key_file: ""  # Leave empty to auto-detect ~/.ssh/id_rsa
