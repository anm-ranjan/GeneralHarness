{
  "name": "myharness-electron",
  "private": true,
  "version": "0.1.0",
  "description": "Electron desktop shell for the local agent harness.",
  "main": "main.js",
  "//": "electron-builder's deb target requires homepage and author for the package metadata it generates; without them `npm run dist:linux` fails after the AppImage is already built.",
  "homepage": "https://github.com/anm-ranjan/GeneralHarness",
  "author": "anm-ranjan",
  "//desktopName": "Linux window association. Electron reads this to set app_id, and electron-builder derives StartupWMClass and (with linux.syncDesktopName) the installed .desktop filename from it, so all three agree and the desktop environment can link a running window to the launcher. Deliberately tied to `name` rather than to the product name, which changes whenever the app is renamed at setup.",
  "desktopName": "myharness-electron.desktop",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "start:dev": "MYHARNESS_ELECTRON_DEV=1 electron .",
    "dist": "electron-builder --config electron-builder.config.cjs",
    "dist:win": "electron-builder --config electron-builder.config.cjs --win",
    "dist:mac": "electron-builder --config electron-builder.config.cjs --mac",
    "dist:linux": "electron-builder --config electron-builder.config.cjs --linux"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.myharness.desktop",
    "productName": "MyHarness",
    "files": [
      "main.js",
      "app-preload.js",
      "executable-path.cjs"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!agent/agent_config.yaml.bak",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/.tool_cache/**"
        ]
      },
      {
        "from": "../frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "../skills",
        "to": "skills"
      },
      {
        "from": "../requirements.txt",
        "to": "requirements.txt"
      },
      {
        "from": "../.venv",
        "to": ".venv"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "anm-ranjan",
      "syncDesktopName": true
    }
  }
}
